# انسخ هذا الملف إلى .env.local واملأ القيم من لوحة Supabase (Project Settings → API)
# بدون هذه القيم يعمل التطبيق في "الوضع التجريبي" على هذا الجهاز فقط.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# اجعلها true بعد تفعيل الدخول بآبل في Supabase
VITE_ENABLE_APPLE=false
# يُظهر قسم استيراد ملف بيانات قديم في شاشة الإدارة
VITE_ENABLE_IMPORT=false
